# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# Required for Google Gemini Live
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: choose from SUPPORTED_VOICE_NAMES in main.py (case-insensitive)
# Example: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
GEMINI_VOICE_NAME="puck"

# Optional Gmail Desktop OAuth client JSON. Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# Optional presentation model overrides
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional: trial/keyword runtime limit
# If ARGUS_TRIAL_KEYWORD is set to any non-empty string,
# Argus will run for ARGUS_RUNTIME_SECONDS (default: 3600).
#ARGUS_TRIAL_KEYWORD="trial"
#ARGUS_RUNTIME_SECONDS="3600"

# Optional: locked container requirements
#ARGUS_LOCKED_KEY_SECRET="expected_unlock_key_contents"
#ARGUS_LOCKED_VOLUME="NameOfVolumeUnderVolumes"

# Optional model and data overrides
#GEMINI_LIVE_MODEL="models/gemini-2.5-flash-native-audio-preview-12-2025"  # used when the key can access it
#ARGUS_CODE_MODEL="gemini-2.5-flash"
#ARGUS_DATA_DIR="/absolute/path/for/argus/data"

# Optional: desktop clap-to-start gate
#ARGUS_SKIP_CLAP_GATE="1"
#ARGUS_ENABLE_CLAP_GATE="1"    # force it on macOS
#ARGUS_REQUIRE_CLAP_GATE="1"   # do not fall back when the microphone fails

# Hosted API (FastAPI + Postgres + Redis)
#ARGUS_API_HOST_PORT="8000"
#PORT="8000"                     # port uvicorn listens on (scripts/start_web_api.sh)
#RUN_MIGRATIONS_ON_START="1"     # set 0 where the platform migrates in a release step
#DATABASE_URL="postgresql://argus:password@localhost:5432/argus"
#REDIS_URL="redis://localhost:6379/0"
#JWT_SECRET="generate-a-long-random-value"
#ARGUS_ENCRYPTION_KEY="generate-a-separate-long-random-value"
#CORS_ORIGINS="http://localhost:3000"
#ARGUS_ENV="development"
#AUTO_CREATE_TABLES="1"
# Defaults to "1" when ARGUS_ENV is production, "0" otherwise.
#REDIS_REQUIRED="0"
# Where the client address for rate limits comes from behind a proxy.
# Use a header your platform sets (Fly: Fly-Client-IP) or the number of
# X-Forwarded-For hops your own proxies append. Leave both unset when the
# API is reached directly.
#CLIENT_IP_HEADER=""
#TRUSTED_PROXY_HOPS="0"
#ACCESS_TOKEN_MINUTES="1440"
#ARGUS_CHAT_MODEL="gemini-2.5-flash"
# Seconds to wait for Gemini before /chat answers 504.
#ARGUS_CHAT_TIMEOUT_SECONDS="60"
# Retain hosted chat, task-history, and answer-cache records for this many days.
# Accounts, saved memory, preferences, and API keys are not removed by this job.
ARGUS_DATA_RETENTION_DAYS="90"

# Web client (web/): where the browser reaches the API. Required for production
# builds; without it the bundle points at http://localhost:8000.
#NEXT_PUBLIC_API_BASE_URL="https://api.example.com"
